LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek-reasoner

DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=vibetrader

# Optional: disable specific data sources
# DISABLE_EASTMONEY=1
# DISABLE_SINA=1

# Watchlist auto daily sync (premarket or intraday)
# WATCHLIST_SYNC_INTERVAL_SECONDS=300
# WATCHLIST_PREMARKET_START=08:30
# WATCHLIST_PREMARKET_END=09:30
